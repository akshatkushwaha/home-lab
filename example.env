# --------------------------------------------------
# HOMELAB ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and enter your values:
#   cp example.env .env
# --------------------------------------------------

# User and group IDs (match host user permissions: id -u / id -g)
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Local LAN IP addresses on the host server (set up both in Netplan)
# PRIVATE_IP hosts admin tools, personal storage, and the private reverse proxy.
# SHARED_IP hosts media, photo, and shared services for Friends and Family.
PRIVATE_IP=192.168.0.100
SHARED_IP=192.168.0.101

# Security and passwords
# Make random passwords with: openssl rand -hex 16
IMMICH_DB_PASSWORD=<secure_random_postgres_password>

# Vaultwarden (set to true only to make the admin account, then set to false)
VAULTWARDEN_DOMAIN=https://vault.madcow.fyi/
VAULTWARDEN_SIGNUPS_ALLOWED=false

# Stirling-PDF security (set to true to turn on login authentication)
STIRLING_ENABLE_SECURITY=false

# Cloudflare and Nginx Proxy Manager (DNS-01 wildcard SSL)
# Enter your Cloudflare API token inside each NPM Web UI for the DNS-01 SSL certificate challenge.

# Storage and ZFS mountpoints
# fast (SSD mirror): storage, photos, and cache. tank (single HDD): bulk media.
STORAGE_DIR=~/storage
PHOTOS_DIR=~/photos
CACHE_DIR=~/cache
MEDIA_DIR=~/media
