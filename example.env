# --------------------------------------------------
# HOMELAB ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and enter your values:
#   cp example.env .env
# --------------------------------------------------

# User and group IDs (match host user permissions: id -u / id -g)
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Local LAN IP address of the host server (used by Homepage dashboard links)
SERVER_IP=192.168.0.100

# Security and passwords
# Make random passwords with: openssl rand -hex 16
IMMICH_DB_PASSWORD=<secure_random_postgres_password>
PAPERLESS_SECRET_KEY=<secure_random_secret_key>

# Vaultwarden (set to true only to make the admin account, then set to false)
VAULTWARDEN_DOMAIN=https://vault.madcow.fyi/
VAULTWARDEN_SIGNUPS_ALLOWED=false

# Stirling-PDF security (set to true to turn on login authentication)
STIRLING_ENABLE_SECURITY=false

# Paperless-ngx domain and URL settings
PAPERLESS_URL=https://paperless.madcow.fyi
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless.madcow.fyi,http://<server-ip>:8777
PAPERLESS_ALLOWED_HOSTS=paperless.madcow.fyi,<server-ip>,localhost

# DuckDNS and Nginx Proxy Manager (DNS-01 wildcard SSL)
# DuckDNS points to your server local LAN IP address (for example, 192.168.0.x).
# Only NPM uses this token for the DNS-01 SSL certificate challenge.
DUCKDNS_KEY=<your_duckdns_token>

# Storage and ZFS mountpoints
# These paths point to ZFS datasets for personal files, photos, and disposable media.
STORAGE_DIR=~/storage
PHOTOS_DIR=~/photos
MEDIA_DIR=~/media
