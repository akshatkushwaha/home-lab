# --------------------------------------------------
# HOMELAB ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in your values:
#   cp example.env .env
# --------------------------------------------------

# User & Group IDs (matches host user permissions: id -u / id -g)
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Host Server Local LAN IP (Used for Homepage dashboard links and internal access)
SERVER_IP=192.168.0.100

# Security & Passwords
# Generate secure passwords with: openssl rand -hex 16
IMMICH_DB_PASSWORD=<secure_random_postgres_password>
PAPERLESS_SECRET_KEY=<secure_random_secret_key>

# Vaultwarden (Set to true ONLY during initial admin account creation, then revert to false)
VAULTWARDEN_DOMAIN=https://vault.<yourdomain>.duckdns.org/
VAULTWARDEN_SIGNUPS_ALLOWED=false

# Stirling-PDF Security (Set to true to enforce login authentication)
STIRLING_ENABLE_SECURITY=false

# Paperless-ngx Domain & URL Settings
PAPERLESS_URL=https://paperless.<yourdomain>.duckdns.org
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless.<yourdomain>.duckdns.org,http://<server-ip>:8777
PAPERLESS_ALLOWED_HOSTS=paperless.<yourdomain>.duckdns.org,<server-ip>,localhost

# DuckDNS & Nginx Proxy Manager (DNS-01 Wildcard SSL)
# DuckDNS points to your server's local LAN IP (e.g. 192.168.0.x).
# The token is only needed inside NPM for the DNS-01 SSL certificate challenge.
DUCKDNS_KEY=<your_duckdns_token>

# Storage & ZFS Mount Points
# Dedicated ZFS datasets for personal files, photos, and disposable media
STORAGE_DIR=~/storage
PHOTOS_DIR=~/photos
MEDIA_DIR=~/media
